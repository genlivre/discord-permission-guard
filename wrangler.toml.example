# wrangler.toml.example
# このファイルをコピーして wrangler.toml を作成してください
# cp wrangler.toml.example wrangler.toml

name = "discord-permission-guard"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[triggers]
crons = [
  "*/10 * * * *",  # 権限チェック + 返信監視ポーリング（10分毎）
  "45 23 * * *",   # 未返信の朝サマリー（23:45 UTC = 8:45 JST）
  "0 6 * * *"      # 未返信の日中リマインド（6:00 UTC = 15:00 JST）
]

# KV Namespace for config storage
# 作成コマンド:
#   npx wrangler kv namespace create CONFIG_KV
#   npx wrangler kv namespace create CONFIG_KV --preview
[[kv_namespaces]]
binding = "CONFIG_KV"
id = "YOUR_KV_NAMESPACE_ID"
preview_id = "YOUR_PREVIEW_KV_NAMESPACE_ID"

[vars]
# 必要ならここに固定の設定を書いてもOK（文字列のみ）
# 例: ENVIRONMENT = "prod"

# 返信監視: 1ギルドあたりの Discord API 呼び出し上限（既定 40 = Free プランでも安全）。
# Workers Paid プラン（サブリクエスト上限 1,000/実行）なら引き上げ推奨。
# 目安: 250 × ギルド数 + 権限チェック分 が 1,000 を超えないように。
# REPLY_API_BUDGET_PER_GUILD = "250"
